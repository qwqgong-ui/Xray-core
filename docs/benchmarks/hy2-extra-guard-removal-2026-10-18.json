{
  "task_date": "2026-10-18",
  "status": "validated in isolated Linux network namespaces; not deployed",
  "problem": "Custom RTT queue protection in the unchanged Xray server starved already-queued MAX_STREAM_DATA frames, limiting one upload stream to about 580 Mbps and causing long stalls under jitter.",
  "history": {
    "xray_guard_introduced": "8d1f52704bf288e19bcb19ccc27252980e53e1aa",
    "mihomo_guard_and_recovery_cap_introduced": "2b44b3db"
  },
  "changes": [
    "Delete both custom RTT queue guards and the extra idle/recovery pacing-rate caps, including state, call sites and obsolete tests.",
    "ACK-only packets no longer debit the software data pacer; paced data and receive-credit frames still debit it.",
    "Keep standard BBR RTT/BDP, DRAIN, PROBE_BW, PROBE_RTT, loss recovery, ECN and explicit app-limited sampler notifications.",
    "Remove the old RTT watchdog from the executable historical Xray patch series, and include the ACK starvation regression there.",
    "Mark the earlier burst-control evidence as historical and withdrawn."
  ],
