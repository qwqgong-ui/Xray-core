 	}
 	return n, err
 }
@@ -451,12 +523,27 @@ func (c *httpServerConn) Write(b []byte) (int, error) {
 func (c *httpServerConn) writeDownlinkHeartbeat() error {
 	c.Lock()
 	defer c.Unlock()
