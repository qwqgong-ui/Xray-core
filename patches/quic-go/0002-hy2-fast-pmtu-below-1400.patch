--- a/mtu_discoverer_test.go
+++ b/mtu_discoverer_test.go
@@ -15,11 +15,32 @@ import (
 	"github.com/stretchr/testify/require"
 )
 
+func TestMTUDiscovererFastTiming(t *testing.T) {
+	const rtt = 100 * time.Millisecond
+	rttStats := utils.NewRTTStats()
+	rttStats.UpdateRTT(rtt, 0)
+	d := newMTUDiscoverer(rttStats, 1399, 1600, nil)
+	now := monotime.Now()
+	d.Start(now)
+	require.False(t, d.ShouldSendProbe(now.Add(2*rtt-time.Nanosecond)))
+	require.True(t, d.ShouldSendProbe(now.Add(2*rtt)))
+	ping, _ := d.GetPing(now.Add(2*rtt))
+	require.False(t, d.ShouldSendProbe(now.Add(4*rtt)))
+	ping.Handler.OnLost(ping.Frame)
+	require.Equal(t, protocol.ByteCount(1399), d.CurrentSize())
+	require.True(t, d.ShouldSendProbe(now.Add(4*rtt)))
+	ping, _ = d.GetPing(now.Add(4*rtt))
+	ping.Handler.OnAcked(ping.Frame)
+	require.GreaterOrEqual(t, d.CurrentSize(), protocol.ByteCount(1400))
+	require.False(t, d.ShouldSendProbe(now.Add(9*rtt-time.Nanosecond)))
+	require.True(t, d.ShouldSendProbe(now.Add(9*rtt)))
+}
