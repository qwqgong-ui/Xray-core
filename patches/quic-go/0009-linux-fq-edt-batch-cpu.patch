diff --git a/kernel_pacing_cpu_test.go b/kernel_pacing_cpu_test.go
new file mode 100644
index 0000000..7a20b15
--- /dev/null
+++ b/kernel_pacing_cpu_test.go
@@ -0,0 +1,53 @@
+//go:build linux && !android
+
+package quic
+
+import (
+	"fmt"
+	"testing"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+)
+
+type kernelPacingBenchmarkConn struct{ sendConn }
+
+func (*kernelPacingBenchmarkConn) WriteBatchWithTxTime(p []kernelPacingPacket) (int, error) {
+	return len(p), nil
+}
+
+// Measure the EDT preparation / accounting path, without encryption or waiting
+// for a receiver. The real kernel clock is used so its syscall cost is included.
+func BenchmarkKernelPacingReadyBatch(b *testing.B) {
+	for _, count := range []int{1, 4, sendQueueCapacity} {
+		b.Run(fmt.Sprint(count), func(b *testing.B) {
+			conn := &kernelPacingBenchmarkConn{}
+			q := newSendQueue(conn).(*sendQueue)
+			var clocks, wakes uint64
+			p := &kernelPacingProvider{
+				rate:  func() uint64 { return 1_000_000_000_000 },
+				clock: func(t monotime.Time) (uint64, error) { clocks++; return kernelTxTime(t) },
+				wake:  func() { wakes++ },
+			}
+			b.SetBytes(int64(1200 * count))
+			b.ReportAllocs()
+			var state kernelPacingQueueState
+			b.ResetTimer()
+			for range b.N {
+				now := monotime.Now()
+				for range count {
+					buf := getPacketBuffer()
+					buf.Data = buf.Data[:1200]
+					q.SendWithPacing(buf, protocol.ECT0, now, 2, kernelPacingMaxLead, p)
+				}
+				_, pending, err := state.writeBatch(q, <-q.queue, conn)
+				if err != nil || pending {
+					b.Fatalf("ready batch: pending=%t err=%v", pending, err)
+				}
+			}
+			b.StopTimer()
+			b.ReportMetric(float64(clocks)/float64(b.N*count), "clocks/packet")
+			b.ReportMetric(float64(wakes)/float64(b.N*count), "wakes/packet")
+		})
+	}
+}
