+// A batch has one pacing provider. Publish its released capacity once after
+// freeing every buffer, rather than waking / contending on it per datagram.
+func (h *sendQueue) releaseBatchEntries(entries []queueEntry) {
+	for _, e := range entries {
+		e.buf.Release()
+	}
+	if p := entries[0].pacing; p != nil {
+		h.pacingPending.Add(-int32(len(entries)))
+		if p.wake != nil {
+			p.wake()
+		}
+	}
+	select {
+	case h.available <- struct{}{}:
+	default:
+	}
+}
