+func TestKernelPacingBatchSharesClockAndWake(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		conn := &pacingBatchTestConn{}
+		q := newSendQueue(conn).(*sendQueue)
+		p := pacingBatchProvider(1_000_000)
+		var clocks, wakes int
+		clock := p.clock
+		p.clock = func(now monotime.Time) (uint64, error) { clocks++; return clock(now) }
+		p.wake = func() { wakes++ }
+		for i := range 4 {
+			enqueuePacingBatch(q, p, byte(i), 40, monotime.Now())
+		}
+		require.NoError(t, drainPacingBatch(q))
+		require.Equal(t, 1, clocks)
+		require.Equal(t, 1, wakes)
+		require.Len(t, conn.accepted, 4)
+		require.Zero(t, q.pacingPending.Load())
+	})
