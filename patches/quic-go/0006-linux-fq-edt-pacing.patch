@@ -0,0 +1,58 @@
+package quic
+
+import (
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+	"testing"
+	"time"
+)
+
+func TestKernelPacingRateAndLeadBound(t *testing.T) {
+	p := kernelPacingState{}
+	now := monotime.Time(time.Hour)
+	a, interval := p.schedule(now, 1200, 1_200_000)
+	if a != now || interval != time.Millisecond {
+		t.Fatalf("departure=%v interval=%v", a, interval)
+	}
+	b, _ := p.schedule(now, 1200, 1_200_000)
+	if b != now.Add(time.Millisecond) {
+		t.Fatalf("spacing: %v", b.Sub(a))
+	}
+	if wait := p.waitUntil(now); wait != now.Add(time.Millisecond) {
+		t.Fatalf("lead not bounded: %v", wait.Sub(now))
+	}
+	p.waitUntil(now.Add(time.Second))
+	d, slow := p.schedule(now.Add(time.Second), 1200, 120_000)
+	if d != now.Add(time.Second) || slow != 10*time.Millisecond {
+		t.Fatal("idle reset or bandwidth change broken")
+	}
+}
+
+func TestKernelPacingDatagramBoundAndIndependentConnections(t *testing.T) {
+	now := monotime.Time(time.Hour)
+	p := kernelPacingState{}
+	for range len(p.departures) {
+		p.schedule(now, protocol.ByteCount(1200), 1_200_000_000)
+	}
+	if p.waitUntil(now.Add(-time.Nanosecond)).IsZero() {
+		t.Fatal("unbounded kernel queue")
+	}
+	other := kernelPacingState{}
+	departure, _ := other.schedule(now, 1200, 1000)
+	if departure != now {
+		t.Fatal("connections share pacing state")
+	}
+	p.waitUntil(now.Add(time.Second))
+	if p.count != 0 {
+		t.Fatal("expired reservations retained")
+	}
+}
+
+func TestKernelPacingUnsupportedSocketFallback(t *testing.T) {
+	c := &Conn{}
+	c.EnableKernelPacing()
+	c.kernelPacingProvider.Store(&kernelPacingProvider{rate: func() uint64 { return 1000 }})
+	if c.kernelPacingReady() {
+		t.Fatal("nil / unsupported socket enabled kernel pacing")
+	}
+}
