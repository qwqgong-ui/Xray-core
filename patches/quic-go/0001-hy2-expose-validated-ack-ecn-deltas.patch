From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: qwqgong-ui <noreply@qwqgong-ui.local>
Date: Sat, 15 Aug 2026 20:10:00 +0900
Subject: [PATCH] quic: expose validated ACK_ECN deltas to congestion control

Keep RFC 9000 ECN validation unchanged, but retain the exact per-ACK ECT(0), ECT(1), and CE counter deltas instead of reducing them to a boolean. Forward them through an optional congestion-controller hook, preserve compatible custom controllers across path migration, and restart ECN validation on the new path.
---
diff --git a/internal/ackhandler/cc_adapter.go b/internal/ackhandler/cc_adapter.go
index d6daa0fd..da3d9c3c 100644
--- a/internal/ackhandler/cc_adapter.go
+++ b/internal/ackhandler/cc_adapter.go
@@ -41,6 +41,12 @@ func (a *ccAdapter) OnCongestionEvent(number protocol.PacketNumber, lostBytes pr
 	a.CC.OnCongestionEvent(congestion.PacketNumber(number), congestion.ByteCount(lostBytes), congestion.ByteCount(priorInFlight))
 }
 
+func (a *ccAdapter) OnECNFeedback(capable, failed bool, ect0, ect1, ecnce uint64) bool {
+	return forwardECNFeedback(a.CC, capable, failed, ect0, ect1, ecnce)
+}
+
+func (a *ccAdapter) OnPathMigration() bool { return forwardPathMigration(a.CC) }
+
 func (a *ccAdapter) OnRetransmissionTimeout(packetsRetransmitted bool) {
 	a.CC.OnRetransmissionTimeout(packetsRetransmitted)
 }
