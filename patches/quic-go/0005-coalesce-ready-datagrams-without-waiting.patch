+package quic
+
+import (
+	"testing"
+
+	"github.com/apernet/quic-go/internal/utils"
+	"github.com/apernet/quic-go/internal/wire"
+	"github.com/stretchr/testify/require"
+	"testing/synctest"
+)
+
+func TestDatagramBatchPopWakesBlockedSenders(t *testing.T) {
+	synctest.Test(t, func(t *testing.T) {
+		q := newDatagramQueue(func() {}, utils.DefaultLogger)
+		for i := 0; i < maxDatagramSendQueueLen; i++ {
+			require.NoError(t, q.Add(&wire.DatagramFrame{DataLenPresent: true, Data: []byte{0}}))
+		}
+		results := make(chan error, 4)
+		for i := 0; i < 4; i++ {
+			go func() { results <- q.Add(&wire.DatagramFrame{DataLenPresent: true, Data: []byte{1}}) }()
+		}
+		synctest.Wait()
+		require.Empty(t, results)
+		for i := 0; i < 4; i++ {
+			q.Pop()
+		}
+		synctest.Wait()
+		require.Len(t, results, 4)
+		for i := 0; i < 4; i++ {
+			require.NoError(t, <-results)
+		}
+	})
+}
