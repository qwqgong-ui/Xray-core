+	h.appDataPackets.SetPathSettled(settled)
+}
+
 func (h *ReceivedPacketHandler) DropPackets(encLevel protocol.EncryptionLevel) {
 	//nolint:exhaustive // 1-RTT packet number space is never dropped.
 	switch encLevel {
diff --git a/internal/ackhandler/received_packet_tracker.go b/internal/ackhandler/received_packet_tracker.go
index 54c047b..1033ef8 100644
--- a/internal/ackhandler/received_packet_tracker.go
+++ b/internal/ackhandler/received_packet_tracker.go
@@ -78,6 +78,28 @@ func (h *receivedPacketTracker) IsPotentiallyDuplicate(pn protocol.PacketNumber)
 // number of ack-eliciting packets received before sending an ACK
 const packetsBeforeAck = 2
 
+// Ack decimation. RFC 9000 section 13.2.1 only says a receiver SHOULD ack every
+// second ack-eliciting packet, and acking less often costs nothing in
+// correctness: an ACK still arrives within the max_ack_delay we advertised, so
+// a peer's loss detection and PTO — both of which already budget for
+// max_ack_delay — see nothing new. What it buys is packets. On a bulk transfer
+// roughly one packet in three is a bare ACK, and on a link metered by packets
+// per second rather than bandwidth those are pure overhead.
+//
+// The cost is feedback granularity, so decimation waits for a path that has
+// stopped changing: path MTU discovery finished, and quiet packets since. While
+// discovery is still probing, its PING probes are exactly the ack-eliciting
+// packets whose ACK advances the search, so delaying those would slow the climb
+// we are decimating on behalf of.
+const (
+	// the largest threshold decimation will walk up to
+	maxPacketsBeforeAck = 4
+	// consecutive undisturbed ack-eliciting packets before raising the
+	// threshold by one, so a brief quiet spell in an otherwise lossy flow does
+	// not earn it
+	packetsPerAckThresholdStep = 100
+)
+
 // The appDataReceivedPacketTracker tracks packets received in the Application Data packet number space.
 // It waits until at least 2 packets were received before queueing an ACK, or until the max_ack_delay was reached.
 type appDataReceivedPacketTracker struct {
@@ -94,6 +116,11 @@ type appDataReceivedPacketTracker struct {
 	ackElicitingPacketsReceivedSinceLastAck int
 	ackAlarm                                monotime.Time
 
+	// ack decimation state
+	pathSettled           bool // path MTU discovery has finished
+	ackThreshold          int  // current threshold, never below packetsBeforeAck
+	quietPacketsSinceStep int
+
 	logger utils.Logger
 }
 
@@ -101,11 +128,47 @@ func newAppDataReceivedPacketTracker(logger utils.Logger) *appDataReceivedPacket
 	h := &appDataReceivedPacketTracker{
 		receivedPacketTracker: *newReceivedPacketTracker(),
 		maxAckDelay:           protocol.MaxAckDelay,
+		ackThreshold:          packetsBeforeAck,
 		logger:                logger,
 	}
 	return h
 }
 
+// SetPathSettled reports whether path MTU discovery has finished. Decimation is
+// only allowed while it has; a reset of discovery (a new path, or a probe
+// failing back down) takes the threshold with it.
+func (h *appDataReceivedPacketTracker) SetPathSettled(settled bool) {
+	if h.pathSettled == settled {
+		return
+	}
+	h.pathSettled = settled
+	if !settled {
+		h.resetAckThreshold()
+	}
+}
+
+func (h *appDataReceivedPacketTracker) resetAckThreshold() {
+	h.ackThreshold = packetsBeforeAck
+	h.quietPacketsSinceStep = 0
+}
+
+// recordQuietPacket counts an ack-eliciting packet that arrived with nothing
+// wrong, and steps the threshold up once enough of them have.
+func (h *appDataReceivedPacketTracker) recordQuietPacket() {
+	if !h.pathSettled || h.ackThreshold >= maxPacketsBeforeAck {
+		return
+	}
+	h.quietPacketsSinceStep++
+	if h.quietPacketsSinceStep < packetsPerAckThresholdStep {
+		return
+	}
+	h.ackThreshold++
+	h.quietPacketsSinceStep = 0
+	if h.logger.Debug() {
+		h.logger.Debugf("\tRaising the ACK threshold to %d packets.", h.ackThreshold)
+	}
+}
+
 func (h *appDataReceivedPacketTracker) ReceivedPacket(pn protocol.PacketNumber, ecn protocol.ECN, rcvTime monotime.Time, ackEliciting bool) error {
 	if err := h.receivedPacketTracker.ReceivedPacket(pn, ecn, ackEliciting); err != nil {
 		return err
@@ -119,6 +182,14 @@ func (h *appDataReceivedPacketTracker) ReceivedPacket(pn protocol.PacketNumber,
 	}
 	h.ackElicitingPacketsReceivedSinceLastAck++
 	isMissing := h.isMissing(pn)
+	if isMissing || ecn == protocol.ECNCE {
+		// The path is no longer quiet. Go back to acking every second packet
+		// until it has been quiet again for a while. shouldQueueACK resets the
+		// threshold for reordering too, but it only runs while no ACK is queued.
+		h.resetAckThreshold()
+	} else {
+		h.recordQuietPacket()
+	}
 	if !h.ackQueued && h.shouldQueueACK(pn, ecn, isMissing) {
 		h.ackQueued = true
 		h.ackAlarm = 0 // cancel the ack alarm
@@ -183,10 +254,10 @@ func (h *appDataReceivedPacketTracker) shouldQueueACK(pn protocol.PacketNumber,
 		return true
 	}
 
-	// send an ACK every 2 ack-eliciting packets
-	if h.ackElicitingPacketsReceivedSinceLastAck >= packetsBeforeAck {
+	// send an ACK every ackThreshold ack-eliciting packets
+	if h.ackElicitingPacketsReceivedSinceLastAck >= h.ackThreshold {
 		if h.logger.Debug() {
-			h.logger.Debugf("\tQueueing ACK because packet %d packets were received after the last ACK (using initial threshold: %d).", h.ackElicitingPacketsReceivedSinceLastAck, packetsBeforeAck)
+			h.logger.Debugf("\tQueueing ACK because packet %d packets were received after the last ACK (using initial threshold: %d).", h.ackElicitingPacketsReceivedSinceLastAck, h.ackThreshold)
 		}
 		return true
 	}
@@ -194,6 +265,7 @@ func (h *appDataReceivedPacketTracker) shouldQueueACK(pn protocol.PacketNumber,
 	// queue an ACK if there are new missing packets to report
 	if h.hasNewMissingPackets() {
 		h.logger.Debugf("\tQueuing ACK because there's a new missing packet to report.")
+		h.resetAckThreshold()
 		return true
 	}
 
