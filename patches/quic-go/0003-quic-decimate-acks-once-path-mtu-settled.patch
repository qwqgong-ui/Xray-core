From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: qwqgong-ui <noreply@qwqgong-ui.local>
Date: Thu, 17 Sep 2026 23:40:00 +0900
Subject: [PATCH] quic: decimate ACKs once path MTU discovery has settled

On a bulk transfer roughly one packet in three is a bare ACK, which is pure overhead on a link metered by packets per second rather than bandwidth. RFC 9000 section 13.2.1 only recommends acking every second ack-eliciting packet, and acking less often stays within the max_ack_delay we advertise, so a peer's loss detection and PTO — which already budget for that delay — see nothing new. Walk the threshold from 2 up to 4 once path MTU discovery reports itself finished and the path stays quiet, and drop straight back to 2 on a missing packet, a reordering report, an ECN-CE mark, or discovery restarting. The gate matters: while discovery is still probing, its PING probes are the ack-eliciting packets whose ACK advances the search. This is receiver-local, so a peer without it simply keeps its own cadence.
---
diff --git a/connection.go b/connection.go
index 0a71b0b..2deffc6 100644
--- a/connection.go
+++ b/connection.go
@@ -2170,6 +2170,13 @@ func (c *Conn) handleAckFrame(frame *wire.AckFrame, encLevel protocol.Encryption
 			c.maxPayloadSizeEstimate.Store(uint32(maxPayloadSize))
 			c.sentPacketHandler.SetMaxDatagramSize(mtu)
 		}
+		// Ack decimation waits for the packet size to stop moving: until then
+		// the probes it would delay are what move it. Asserted on the concrete
+		// finder rather than added to the mtuDiscoverer interface, so a
+		// discoverer that cannot report this simply never unlocks decimation.
+		if f, ok := c.mtuDiscoverer.(*mtuFinder); ok {
+			c.receivedPacketHandler.SetPathSettled(f.done())
+		}
 	}
 	return c.cryptoStreamHandler.SetLargest1RTTAcked(frame.LargestAcked())
 }
diff --git a/internal/ackhandler/ack_decimation_test.go b/internal/ackhandler/ack_decimation_test.go
new file mode 100644
index 0000000..0da1e6e
--- /dev/null
+++ b/internal/ackhandler/ack_decimation_test.go
@@ -0,0 +1,139 @@
+package ackhandler
+
+import (
+	"testing"
+	"time"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+	"github.com/apernet/quic-go/internal/utils"
+
+	"github.com/stretchr/testify/require"
+)
+
+// feedQuiet delivers n in-order ack-eliciting packets starting at pn, draining
+// any ACK each one queues, and reports how many ACKs were produced.
+func feedQuiet(t *testing.T, tr *appDataReceivedPacketTracker, pn protocol.PacketNumber, n int) (acks int, next protocol.PacketNumber) {
+	t.Helper()
+	for i := 0; i < n; i++ {
+		require.NoError(t, tr.ReceivedPacket(pn, protocol.ECNNon, monotime.Now(), true))
+		if tr.GetAckFrame(monotime.Now(), true) != nil {
+			acks++
+		}
+		pn++
+	}
+	return acks, pn
+}
+
+// Until path MTU discovery reports itself finished, nothing changes: a peer
+// without the patch, and a patched peer whose path is still being probed, both
+// keep the RFC 9000 every-second-packet cadence.
+func TestAckDecimationStaysOffUntilPathSettles(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+
+	const packets = 10 * packetsPerAckThresholdStep
+	acks, _ := feedQuiet(t, tr, 1, packets)
+	require.Equal(t, packets/packetsBeforeAck, acks)
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+}
+
+// Once the path has settled, the threshold walks up one step at a time and
+// stops at maxPacketsBeforeAck.
+func TestAckDecimationWalksUpAndStops(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+
+	pn := protocol.PacketNumber(1)
+	for want := packetsBeforeAck + 1; want <= maxPacketsBeforeAck; want++ {
+		_, pn = feedQuiet(t, tr, pn, packetsPerAckThresholdStep)
+		require.Equal(t, want, tr.ackThreshold)
+	}
+
+	// Far past the last step, it holds at the ceiling.
+	_, pn = feedQuiet(t, tr, pn, 10*packetsPerAckThresholdStep)
+	require.Equal(t, maxPacketsBeforeAck, tr.ackThreshold)
+
+	// And that is the cadence actually used on the wire.
+	const packets = 4 * packetsPerAckThresholdStep
+	acks, _ := feedQuiet(t, tr, pn, packets)
+	require.Equal(t, packets/maxPacketsBeforeAck, acks)
+}
+
+// A packet the last ACK reported missing means the path is no longer quiet, so
+// the cadence drops straight back to every second packet.
+func TestAckDecimationResetsOnMissingPacket(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+
+	_, pn := feedQuiet(t, tr, 10, packetsPerAckThresholdStep)
+	require.Greater(t, tr.ackThreshold, packetsBeforeAck)
+
+	// Skip one, ack the gap, then let the skipped packet arrive late.
+	skipped := pn
+	_, pn = feedQuiet(t, tr, pn+1, maxPacketsBeforeAck)
+	require.NoError(t, tr.ReceivedPacket(skipped, protocol.ECNNon, monotime.Now(), true))
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+
+	// It has to earn the higher threshold again.
+	_, pn = feedQuiet(t, tr, pn, packetsPerAckThresholdStep-1)
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+}
+
+// Congestion signalled by the network resets it too.
+func TestAckDecimationResetsOnECNCE(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+
+	_, pn := feedQuiet(t, tr, 1, packetsPerAckThresholdStep)
+	require.Greater(t, tr.ackThreshold, packetsBeforeAck)
+
+	require.NoError(t, tr.ReceivedPacket(pn, protocol.ECNCE, monotime.Now(), true))
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+}
+
+// Path MTU discovery restarting — a new path, or a probe failing back down —
+// takes the earned threshold with it.
+func TestAckDecimationResetsWhenPathUnsettles(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+
+	_, pn := feedQuiet(t, tr, 1, packetsPerAckThresholdStep)
+	require.Greater(t, tr.ackThreshold, packetsBeforeAck)
+
+	tr.SetPathSettled(false)
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+
+	// Still pinned to the default however long it stays quiet.
+	_, _ = feedQuiet(t, tr, pn, 2*packetsPerAckThresholdStep)
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+}
+
+// Decimation must never delay an ACK past the max_ack_delay we advertised:
+// that bound is what every peer's loss detection and PTO already budget for,
+// and is why acking less often is safe against an unpatched sender.
+func TestAckDecimationKeepsMaxAckDelay(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+	_, pn := feedQuiet(t, tr, 1, packetsPerAckThresholdStep*(maxPacketsBeforeAck-packetsBeforeAck))
+	require.Equal(t, maxPacketsBeforeAck, tr.ackThreshold)
+
+	// Land on an ACK boundary so the packet counter is back at zero.
+	for tr.GetAckFrame(monotime.Now(), true) == nil {
+		require.NoError(t, tr.ReceivedPacket(pn, protocol.ECNNon, monotime.Now(), true))
+		pn++
+	}
+
+	// Short of the threshold no ACK is queued, but the alarm stays armed at
+	// max_ack_delay from the most recent packet.
+	now := monotime.Now()
+	for i := 0; i < maxPacketsBeforeAck-1; i++ {
+		now = now.Add(time.Millisecond)
+		require.NoError(t, tr.ReceivedPacket(pn, protocol.ECNNon, now, true))
+		require.Nil(t, tr.GetAckFrame(now, true))
+		require.Equal(t, now.Add(protocol.MaxAckDelay), tr.GetAlarmTimeout())
+		pn++
+	}
+
+	// The alarm fires on time and produces the ACK.
+	require.NotNil(t, tr.GetAckFrame(now.Add(protocol.MaxAckDelay), true))
+}
