+package quic
+
+import (
+	"testing"
+	"time"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+
+	"github.com/stretchr/testify/require"
+	"go.uber.org/mock/gomock"
+)
+
+// Exercise the actual authenticated short-header receive entry point. A policy
+// test that only supplies sizes directly to the ACK tracker would miss a broken
+// connection-to-tracker bridge.
+func TestConnectionReceiveRateACKPolicy(t *testing.T) {
+	ctrl := gomock.NewController(t)
+	unpacker := NewMockUnpacker(ctrl)
+	tc := newServerTestConnection(t, ctrl, nil, false, connectionOptUnpacker(unpacker))
+	tc.receivedPacketHandler().SetPathSettled(true)
+	now := monotime.Time(time.Hour)
+	pn := protocol.PacketNumber(1)
+	payload := make([]byte, 1250)
+	payload[0] = 0x1 // PING followed by padding
+	receive := func(interval time.Duration) bool {
+		t.Helper()
+		now = now.Add(interval)
+		packet := getShortHeaderPacket(t, tc.remoteAddr, tc.srcConnID, pn, payload)
+		packet.rcvTime = now
+		unpacker.EXPECT().UnpackShortHeader(gomock.Any(), gomock.Any()).Return(
+			pn, protocol.PacketNumberLen2, protocol.KeyPhaseZero, payload, nil,
+		)
+		processed, err := tc.conn.handleOnePacket(packet, 0)
+		require.NoError(t, err)
+		require.True(t, processed)
+		pn++
+		return tc.receivedPacketHandler().GetAckFrame(protocol.Encryption1RTT, now, true) != nil
+	}
+	for i := 0; i < 2048; i++ {
+		receive(20 * time.Microsecond)
+	}
+	tc.receivedPacketHandler().GetAckFrame(protocol.Encryption1RTT, now, false)
+
+	// Idle ages out the high receive rate; the retained bulk ceiling must not
+	// cause sparse packets to wait for six/eight packets.
+	now = now.Add(100 * time.Millisecond)
+	for i := 1; i <= 96; i++ {
+		require.Equal(t, i%2 == 0, receive(200*time.Microsecond), "low-rate packet %d", i)
+	}
+	require.True(t, tc.receivedPacketHandler().GetAlarmTimeout().IsZero())
+	require.Nil(t, tc.receivedPacketHandler().GetAckFrame(protocol.Encryption1RTT, now.Add(time.Hour), true))
+
+	for i := 0; i < 2048; i++ {
+		receive(20 * time.Microsecond)
+	}
+	tc.receivedPacketHandler().GetAckFrame(protocol.Encryption1RTT, now, false)
+	acks := 0
+	for i := 0; i < 96; i++ {
+		if receive(20 * time.Microsecond) {
+			acks++
+		}
+	}
+	require.Equal(t, 96/8, acks)
+}
