diff --git a/internal/ackhandler/ack_receive_rate.go b/internal/ackhandler/ack_receive_rate.go
new file mode 100644
index 0000000..b175236
--- /dev/null
+++ b/internal/ackhandler/ack_receive_rate.go
@@ -0,0 +1,62 @@
+package ackhandler
+
+import (
+	"time"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+)
+
+const (
+	ackDecimationMinBytesPerSecond = 100_000_000 / 8 // decimal 100 Mbps
+	ackReceiveRateWindow           = 20 * time.Millisecond
+	ackReceiveRateMinSample        = time.Millisecond
+)
+
+// ackReceiveRate measures accepted, ack-eliciting QUIC wire bytes, independently
+// of the sender's bandwidth model. Two weighted buckets avoid a rate dip at each
+// window boundary. No timer or allocation is needed: idle state expires on the
+// next received packet, and cannot create unsolicited ACKs.
+type ackReceiveRate struct {
+	windowStart, lastReceived   monotime.Time
+	currentBytes, previousBytes int64
+	known, fullWindow, highRate bool
+}
+
+func (r *ackReceiveRate) record(size protocol.ByteCount, now monotime.Time) {
+	if size <= 0 {
+		return
+	}
+	elapsed := now.Sub(r.windowStart)
+	if !r.known || now.Before(r.lastReceived) || elapsed >= 2*ackReceiveRateWindow {
+		*r = ackReceiveRate{windowStart: now, known: true}
+		elapsed = 0
+	} else if elapsed >= ackReceiveRateWindow {
+		r.previousBytes = r.currentBytes
+		r.currentBytes = 0
+		r.windowStart = r.windowStart.Add(ackReceiveRateWindow)
+		r.fullWindow = true
+		elapsed -= ackReceiveRateWindow
+	}
+	r.lastReceived = now
+	r.currentBytes += int64(size)
+	if !r.fullWindow {
+		// The floor prevents a shared receive timestamp / GRO burst from
+		// turning one small packet into an infinite-rate sample.
+		sample := elapsed
+		if sample < ackReceiveRateMinSample {
+			sample = ackReceiveRateMinSample
+		}
+		r.highRate = r.currentBytes*int64(time.Second) >= ackDecimationMinBytesPerSecond*int64(sample)
+		return
+	}
+	weightedBytes := r.currentBytes*int64(ackReceiveRateWindow) +
+		r.previousBytes*int64(ackReceiveRateWindow-elapsed)
+	r.highRate = weightedBytes >=
+		ackDecimationMinBytesPerSecond*int64(ackReceiveRateWindow)/int64(time.Second)*int64(ackReceiveRateWindow)
+}
+
+func (r *ackReceiveRate) allowsDecimation() bool {
+	// Calls without a size preserve the existing internal API's behavior.
+	return !r.known || r.highRate
+}
diff --git a/internal/ackhandler/adaptive_ack_policy_test.go b/internal/ackhandler/adaptive_ack_policy_test.go
