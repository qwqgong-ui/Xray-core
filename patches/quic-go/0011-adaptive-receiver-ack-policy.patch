+++ b/internal/ackhandler/adaptive_ack_policy_test.go
@@ -0,0 +1,305 @@
+package ackhandler
+
+import (
+	"testing"
+	"time"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"github.com/apernet/quic-go/internal/protocol"
+	"github.com/apernet/quic-go/internal/utils"
+
+	"github.com/stretchr/testify/require"
+)
+
+func warmHighRateACKTracker(t *testing.T) (*appDataReceivedPacketTracker, protocol.PacketNumber, monotime.Time) {
+	t.Helper()
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+	now := monotime.Time(time.Hour)
+	pn := protocol.PacketNumber(1)
+	for ; pn <= 2000; pn++ {
+		now = now.Add(20 * time.Microsecond)
+		require.NoError(t, tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, 1250))
+		tr.GetAckFrame(now, true)
+	}
+	tr.GetAckFrame(now, false)
+	require.Equal(t, maxPacketsBeforeAck, tr.ackThreshold)
+	require.True(t, tr.receiveRate.highRate)
+	return tr, pn, now
+}
+
+func TestReceiveRateACKLowSpeedUsesTwo(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+	// A formerly fast, still-settled path must use two without losing its earned ceiling.
+	tr.ackThreshold = maxPacketsBeforeAck
+	now := monotime.Time(time.Hour)
+	for i := 1; i <= 200; i++ {
+		now = now.Add(200 * time.Microsecond) // 50 Mbps of QUIC wire bytes
+		require.NoError(t, tr.receivedPacketWithSize(protocol.PacketNumber(i), protocol.ECNNon, now, true, 1250))
+		ack := tr.GetAckFrame(now, true)
+		if i%2 == 0 {
+			require.NotNil(t, ack, "packet %d", i)
+			require.True(t, tr.GetAlarmTimeout().IsZero())
+		} else {
+			require.Nil(t, ack, "no ACK1 at packet %d", i)
+		}
+		require.False(t, tr.receiveRate.highRate)
+	}
+	require.Equal(t, maxPacketsBeforeAck, tr.ackThreshold)
+	require.Zero(t, tr.quietPacketsSinceStep)
+}
+
+func TestReceiveRateACKHighSpeedDecimates(t *testing.T) {
+	tr, pn, now := warmHighRateACKTracker(t)
+	acks := 0
+	for i := 0; i < maxPacketsBeforeAck*20; i++ {
+		now = now.Add(20 * time.Microsecond)
+		require.NoError(t, tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, 1250))
+		if tr.GetAckFrame(now, true) != nil {
+			acks++
+		}
+		require.True(t, tr.receiveRate.highRate)
+		pn++
+	}
+	require.Equal(t, 20, acks)
+}
+
+func TestReceiveRateACKOnlyHighSpeedEarnsDecimation(t *testing.T) {
+	tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+	tr.SetPathSettled(true)
+	now := monotime.Time(time.Hour)
+	pn := protocol.PacketNumber(1)
+	for ; pn <= 1000; pn++ {
+		now = now.Add(200 * time.Microsecond)
+		require.NoError(t, tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, 1250))
+		tr.GetAckFrame(now, true)
+	}
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+	require.Zero(t, tr.quietPacketsSinceStep)
+	for i := 0; i < 2000; i++ {
+		now = now.Add(20 * time.Microsecond)
+		require.NoError(t, tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, 1250))
+		tr.GetAckFrame(now, true)
+		pn++
+	}
+	require.Equal(t, maxPacketsBeforeAck, tr.ackThreshold)
+}
+
+func TestReceiveRateACKIdleReturnsToTwoWithoutPeriodicACK(t *testing.T) {
+	tr, pn, now := warmHighRateACKTracker(t)
+	require.Nil(t, tr.GetAckFrame(now.Add(time.Hour), true))
+	require.True(t, tr.GetAlarmTimeout().IsZero())
+	now = now.Add(100 * time.Millisecond)
+	require.NoError(t, tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, 1250))
+	require.False(t, tr.receiveRate.highRate)
+	require.Nil(t, tr.GetAckFrame(now, true), "first sparse packet still uses ACK2")
+	require.Equal(t, now.Add(tr.maxAckDelay), tr.GetAlarmTimeout())
+	now = now.Add(time.Millisecond)
+	require.NoError(t, tr.receivedPacketWithSize(pn+1, protocol.ECNNon, now, true, 1250))
+	require.NotNil(t, tr.GetAckFrame(now, true))
+	require.True(t, tr.GetAlarmTimeout().IsZero())
+	require.Nil(t, tr.GetAckFrame(now.Add(time.Hour), true))
+}
+
+func TestReceiveRateACKTailRetainsDeadline(t *testing.T) {
+	tr, pn, now := warmHighRateACKTracker(t)
+	tr.SetAckDelay(5 * time.Millisecond)
+	first := now.Add(100 * time.Microsecond)
+	for i := 0; i < 4; i++ {
+		at := first.Add(time.Duration(i) * 100 * time.Microsecond)
+		require.NoError(t, tr.receivedPacketWithSize(pn+protocol.PacketNumber(i), protocol.ECNNon, at, true, 1250))
+		require.True(t, tr.receiveRate.highRate)
+		require.Nil(t, tr.GetAckFrame(at, true))
+	}
+	deadline := first.Add(5 * time.Millisecond)
+	require.Equal(t, deadline, tr.GetAlarmTimeout())
+	require.Nil(t, tr.GetAckFrame(deadline.Add(-time.Nanosecond), true))
+	require.NotNil(t, tr.GetAckFrame(deadline, true))
+	require.True(t, tr.GetAlarmTimeout().IsZero())
+}
+
+func TestReceiveRateACKGapResetsCadenceAcrossFastPaths(t *testing.T) {
+	for _, queued := range []bool{false, true} {
+		name := "packet-count-boundary"
+		if queued {
+			name = "already-queued"
+		}
+		t.Run(name, func(t *testing.T) {
+			tr, pn, now := warmHighRateACKTracker(t)
+			count := maxPacketsBeforeAck - 1
+			if queued {
+				count++
+			}
+			for i := 0; i < count; i++ {
+				now = now.Add(20 * time.Microsecond)
+				require.NoError(t, tr.receivedPacketWithSize(pn+protocol.PacketNumber(i), protocol.ECNNon, now, true, 1250))
+			}
+			require.Equal(t, queued, tr.ackQueued)
+			gapPN := pn + 20
+			now = now.Add(20 * time.Microsecond)
+			require.NoError(t, tr.receivedPacketWithSize(gapPN, protocol.ECNNon, now, true, 1250))
+			require.True(t, tr.receiveRate.highRate)
+			require.True(t, tr.hasNewMissingPackets())
+			require.NotNil(t, tr.GetAckFrame(now, true))
+			require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+			for i := 1; i <= packetsBeforeAck; i++ {
+				now = now.Add(20 * time.Microsecond)
+				require.NoError(t, tr.receivedPacketWithSize(gapPN+protocol.PacketNumber(i), protocol.ECNNon, now, true, 1250))
+				if i < packetsBeforeAck {
+					require.Nil(t, tr.GetAckFrame(now, true))
+				}
+			}
+			require.NotNil(t, tr.GetAckFrame(now, true))
+		})
+	}
+}
+
+func TestReceiveRateACKPTOGapAndCEStayImmediate(t *testing.T) {
+	for _, ce := range []bool{false, true} {
+		name := "pto-skipped-number"
+		if ce {
+			name = "ecn-ce"
+		}
+		t.Run(name, func(t *testing.T) {
+			tr, pn, now := warmHighRateACKTracker(t)
+			ecn := protocol.ECNNon
+			if ce {
+				ecn = protocol.ECNCE
+			} else {
+				pn++
+			}
+			now = now.Add(20 * time.Microsecond)
+			require.NoError(t, tr.receivedPacketWithSize(pn, ecn, now, true, 1250))
+			require.NotNil(t, tr.GetAckFrame(now, true))
+			require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+			require.True(t, tr.GetAlarmTimeout().IsZero())
+		})
+	}
+}
+
+func TestReceiveRateACKIgnoresACKOnlyAndRejectedPackets(t *testing.T) {
+	tr, pn, now := warmHighRateACKTracker(t)
+	before := tr.receiveRate
+	require.NoError(t, tr.receivedPacketWithSize(pn, protocol.ECNNon, now, false, 64000))
+	require.Equal(t, before, tr.receiveRate)
+	require.Nil(t, tr.GetAckFrame(now.Add(time.Second), true))
+	require.True(t, tr.GetAlarmTimeout().IsZero())
+	require.Error(t, tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, 64000))
+	require.Equal(t, before, tr.receiveRate)
+}
+
+func TestReceiveRateACKPacketSpaces(t *testing.T) {
+	h := NewReceivedPacketHandler(utils.DefaultLogger)
+	now := monotime.Time(time.Hour)
+	for _, level := range []protocol.EncryptionLevel{protocol.EncryptionInitial, protocol.EncryptionHandshake} {
+		require.NoError(t, h.ReceivedPacketWithSize(1, protocol.ECNNon, level, now, true, 1250))
+		require.NotNil(t, h.GetAckFrame(level, now, true))
+	}
+	require.False(t, h.appDataPackets.receiveRate.known)
+	require.NoError(t, h.ReceivedPacketWithSize(1, protocol.ECNNon, protocol.Encryption0RTT, now, true, 1250))
+	require.Nil(t, h.GetAckFrame(protocol.Encryption1RTT, now, true))
+	require.NoError(t, h.ReceivedPacketWithSize(2, protocol.ECNNon, protocol.Encryption1RTT, now.Add(time.Millisecond), true, 1250))
+	require.NotNil(t, h.GetAckFrame(protocol.Encryption1RTT, now.Add(time.Millisecond), true))
+	require.True(t, h.appDataPackets.receiveRate.known)
+	require.EqualValues(t, 2500, h.appDataPackets.receiveRate.currentBytes)
+}
+
+func TestReceiveRateACKPathResetClearsRate(t *testing.T) {
+	tr, _, _ := warmHighRateACKTracker(t)
+	tr.SetPathSettled(false)
+	require.Equal(t, ackReceiveRate{}, tr.receiveRate)
+	require.Equal(t, packetsBeforeAck, tr.ackThreshold)
+}
+
+func TestReceiveRateThresholdAndWindowBoundaries(t *testing.T) {
+	now := monotime.Time(time.Hour)
+	for _, sample := range []struct {
+		size protocol.ByteCount
+		high bool
+	}{{12499, false}, {12500, true}, {12501, true}} {
+		var rate ackReceiveRate
+		rate.record(sample.size, now)
+		require.Equal(t, sample.high, rate.highRate, "size %d in minimum 1 ms", sample.size)
+	}
+	for _, sample := range []struct {
+		name     string
+		interval time.Duration
+		high     bool
+	}{
+		{"50Mbps", 200 * time.Microsecond, false},
+		{"99Mbps", 101 * time.Microsecond, false},
+		{"100Mbps", 100 * time.Microsecond, true},
+		{"500Mbps", 20 * time.Microsecond, true},
+	} {
+		t.Run(sample.name, func(t *testing.T) {
+			var rate ackReceiveRate
+			at := now
+			for i := 0; i < 4096; i++ {
+				at = at.Add(sample.interval)
+				rate.record(1250, at)
+				if i > 400 {
+					require.Equal(t, sample.high, rate.highRate, "packet %d across bucket boundary", i)
+				}
+			}
+		})
+	}
+}
+
+func TestReceiveRateIdleAndClockRegression(t *testing.T) {
+	now := monotime.Time(time.Hour)
+	for _, at := range []monotime.Time{now.Add(2 * ackReceiveRateWindow), now.Add(-time.Nanosecond)} {
+		var rate ackReceiveRate
+		rate.record(25000, now)
+		require.True(t, rate.highRate)
+		rate.record(1250, at)
+		require.False(t, rate.highRate)
+		require.Zero(t, rate.previousBytes)
+		require.EqualValues(t, 1250, rate.currentBytes)
+	}
+	var rate ackReceiveRate
+	rate.record(0, now)
+	rate.record(-1, now)
+	require.False(t, rate.known)
+}
+
+func BenchmarkReceiveRateACKTracker(b *testing.B) {
+	for _, sample := range []struct {
+		name     string
+		interval time.Duration
+		size     protocol.ByteCount
+	}{
+		{"legacy-unknown-size", 20 * time.Microsecond, 0},
+		{"50Mbps-ACK2", 200 * time.Microsecond, 1250},
+		{"500Mbps-decimated", 20 * time.Microsecond, 1250},
+	} {
+		b.Run(sample.name, func(b *testing.B) {
+			tr := newAppDataReceivedPacketTracker(utils.DefaultLogger)
+			tr.SetPathSettled(true)
+			now := monotime.Time(time.Hour)
+			pn := protocol.PacketNumber(1)
+			for ; pn <= 2000; pn++ {
+				now = now.Add(sample.interval)
+				if err := tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, sample.size); err != nil {
+					b.Fatal(err)
+				}
+				tr.GetAckFrame(now, true)
+			}
+			tr.GetAckFrame(now, false)
+			acks := 0
+			b.ReportAllocs()
+			b.ResetTimer()
+			for i := 0; i < b.N; i++ {
+				now = now.Add(sample.interval)
+				if err := tr.receivedPacketWithSize(pn, protocol.ECNNon, now, true, sample.size); err != nil {
+					b.Fatal(err)
+				}
+				if tr.GetAckFrame(now, true) != nil {
+					acks++
+				}
+				pn++
+			}
+			b.ReportMetric(float64(acks)/float64(b.N), "ACK/packet")
+		})
+	}
+}
