+func (c *kernelRejectTxTimeConn) WriteMsgUDP(b, oob []byte, addr *net.UDPAddr) (int, int, error) {
+	msgs, err := unix.ParseSocketControlMessage(oob)
+	if err != nil {
+		return 0, 0, err
+	}
+	for _, msg := range msgs {
+		if msg.Header.Level == unix.SOL_SOCKET && msg.Header.Type == unix.SCM_TXTIME {
+			c.timed++
+			return 0, 0, unix.EOPNOTSUPP
+		}
+	}
+	c.plain++
+	return len(b), len(oob), nil
+}
