+	buf := getPacketBuffer()
+	buf.Data = append(buf.Data, make([]byte, 1200)...)
+	queue.SendWithPacing(buf, protocol.ECT0, departure, time.Millisecond, time.Millisecond, p)
+	done := make(chan error, 1)
+	go func() { done <- queue.Run() }()
+	queue.Close()
