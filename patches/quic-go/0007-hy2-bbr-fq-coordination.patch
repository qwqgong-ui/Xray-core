diff --git a/kernel_pacing_fq_linux.go b/kernel_pacing_fq_linux.go
new file mode 100644
index 0000000..0375e01
--- /dev/null
+++ b/kernel_pacing_fq_linux.go
@@ -0,0 +1,377 @@
+//go:build linux && !android
+
+package quic
+
+import (
+	"encoding/binary"
+	"errors"
+	"net"
+	"os"
+	"syscall"
+	"time"
+
+	"github.com/apernet/quic-go/internal/monotime"
+	"golang.org/x/sys/unix"
+)
+
+const kernelPacingPathTTL = 5 * time.Second
+
+// Linux UAPI values not exported by x/sys/unix on all architectures.
+const kernelPacingTcMsgSize = 20
+
+func isKernelPacingUnsupported(err error) bool {
+	return errors.Is(err, unix.EINVAL) || errors.Is(err, unix.ENOPROTOOPT) || errors.Is(err, unix.EOPNOTSUPP)
+}
+
+// SO_TXTIME alone does not prove that the route uses fq. Cache per sending
+// path, not per shared listener socket; address / packet-info changes invalidate
+// immediately, and route or qdisc changes are rechecked within a short TTL.
+func (c *sconn) kernelPacingPathReady() bool {
+	ai := c.remoteAddrInfo.Load()
+	now := monotime.Now()
+	if ai == c.kernelPacingPathInfo && now.Sub(c.kernelPacingPathChecked) < kernelPacingPathTTL {
+		return c.kernelPacingPathOK
+	}
+	c.kernelPacingPathInfo, c.kernelPacingPathChecked = ai, now
+	c.kernelPacingPathOK = false
+	remote, ok := ai.addr.(*net.UDPAddr)
+	if !ok {
+		return false
+	}
+	conn, ok := c.rawConn.(interface {
+		SyscallConn() (syscall.RawConn, error)
+	})
+	if !ok {
+		return false
+	}
+	raw, err := conn.SyscallConn()
+	if err != nil {
+		return false
+	}
+	var cookie uint64
+	var mark, bound int
+	var tos int
+	var socketErr error
+	err = raw.Control(func(fd uintptr) {
+		cookie, socketErr = unix.GetsockoptUint64(int(fd), unix.SOL_SOCKET, unix.SO_NETNS_COOKIE)
+		if socketErr != nil {
+			return
+		}
+		mark, socketErr = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_MARK)
+		if socketErr != nil {
+			return
+		}
+		bound, socketErr = unix.GetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_BINDTOIFINDEX)
+		if socketErr != nil {
+			return
+		}
+		if remote.IP.To4() != nil {
+			tos, socketErr = unix.GetsockoptInt(int(fd), unix.IPPROTO_IP, unix.IP_TOS)
+		} else {
+			tos, socketErr = unix.GetsockoptInt(int(fd), unix.IPPROTO_IPV6, unix.IPV6_TCLASS)
+		}
+	})
+	if err != nil || socketErr != nil {
+		return false
+	}
+	// quic-go's ECN cmsg writes the entire TOS/TCLASS byte, clearing socket
+	// DSCP. Until that existing behavior can be represented per packet, do
+	// not validate a DSCP policy route that may differ from the sendmsg route.
+	if tos&0xfc != 0 && c.rawConn.capabilities().ECN {
+		return false
+	}
+	local, ok := c.rawConn.LocalAddr().(*net.UDPAddr)
+	if !ok {
+		return false
+	}
+	source := local.IP
+	oif := bound
+	msgs, err := unix.ParseSocketControlMessage(ai.oob)
+	if err != nil {
+		return false
+	}
+	for _, msg := range msgs {
+		var infoIndex int
+		if msg.Header.Level == unix.IPPROTO_IP && msg.Header.Type == unix.IP_PKTINFO && len(msg.Data) == 12 {
+			infoIndex = int(binary.NativeEndian.Uint32(msg.Data[:4]))
+			source = net.IP(msg.Data[4:8])
+		} else if msg.Header.Level == unix.IPPROTO_IPV6 && msg.Header.Type == unix.IPV6_PKTINFO && len(msg.Data) == 20 {
+			infoIndex = int(binary.NativeEndian.Uint32(msg.Data[16:]))
+			source = net.IP(msg.Data[:16])
+		}
+		if infoIndex > 0 {
+			if oif != 0 && oif != infoIndex {
+				return false
+			}
+			oif = infoIndex
+		}
+	}
+	if remote.Zone != "" {
+		iface, err := net.InterfaceByName(remote.Zone)
+		if err != nil || (oif != 0 && oif != iface.Index) {
+			return false
+		}
+		oif = iface.Index
+	}
+	index, err := kernelPacingRoute(remote, source, local.Port, oif, mark, byte(tos&0xfc), cookie)
+	if err != nil {
+		return false
+	}
+	c.kernelPacingPathOK = kernelPacingFQ(index, cookie)
+	if c.logger != nil && c.logger.Debug() {
+		c.logger.Debugf("Linux FQ EDT path %s: ready=%t, interface=%d", remote, c.kernelPacingPathOK, index)
+	}
+	return c.kernelPacingPathOK
+}
+
+func kernelPacingAttr(data []byte, typ uint16, value []byte) []byte {
+	n := 4 + len(value)
+	start := len(data)
+	data = append(data, make([]byte, (n+3)&^3)...)
+	binary.NativeEndian.PutUint16(data[start:], uint16(n))
+	binary.NativeEndian.PutUint16(data[start+2:], typ)
+	copy(data[start+4:], value)
+	return data
+}
+
+func kernelPacingAttrs(data []byte) (map[uint16][]byte, error) {
+	attrs := make(map[uint16][]byte)
+	for len(data) > 0 {
+		if len(data) < 4 {
+			return nil, unix.EINVAL
+		}
+		n := int(binary.NativeEndian.Uint16(data))
+		aligned := (n + 3) &^ 3
+		if n < 4 || aligned > len(data) {
+			return nil, unix.EINVAL
+		}
+		typ := binary.NativeEndian.Uint16(data[2:]) & 0x3fff
+		if _, exists := attrs[typ]; exists {
+			return nil, unix.EINVAL
+		}
+		attrs[typ] = data[4:n]
+		data = data[aligned:]
+	}
+	return attrs, nil
+}
+
+func kernelPacingU32(n uint32) []byte {
+	var v [4]byte
+	binary.NativeEndian.PutUint32(v[:], n)
+	return v[:]
+}
+
+func kernelPacingRoute(remote *net.UDPAddr, source net.IP, port, oif, mark int, tos byte, cookie uint64) (int, error) {
+	data := make([]byte, unix.SizeofRtMsg)
+	data[0], data[1], data[3] = unix.AF_INET, 32, tos
+	dest := remote.IP.To4()
+	if dest == nil {
+		data[0], data[1] = unix.AF_INET6, 128
+		dest = remote.IP.To16()
+	}
+	if dest == nil {
+		return 0, unix.EINVAL
+	}
+	data = kernelPacingAttr(data, unix.RTA_DST, dest)
+	if len(source) > 0 && !source.IsUnspecified() {
+		if len(dest) == 4 {
+			source = source.To4()
+		} else {
+			source = source.To16()
+		}
+		if source == nil {
+			return 0, unix.EINVAL
+		}
+		data[2] = byte(len(source) * 8)
+		data = kernelPacingAttr(data, unix.RTA_SRC, source)
+	}
+	if oif > 0 {
+		data = kernelPacingAttr(data, unix.RTA_OIF, kernelPacingU32(uint32(oif)))
+	}
+	if mark != 0 {
+		data = kernelPacingAttr(data, unix.RTA_MARK, kernelPacingU32(uint32(mark)))
+	}
+	data = kernelPacingAttr(data, unix.RTA_UID, kernelPacingU32(uint32(os.Getuid())))
+	data = kernelPacingAttr(data, unix.RTA_IP_PROTO, []byte{unix.IPPROTO_UDP})
+	var ports [2]byte
+	binary.BigEndian.PutUint16(ports[:], uint16(port))
+	data = kernelPacingAttr(data, unix.RTA_SPORT, ports[:])
+	binary.BigEndian.PutUint16(ports[:], uint16(remote.Port))
+	data = kernelPacingAttr(data, unix.RTA_DPORT, ports[:])
+	msgs, err := kernelPacingNetlink(unix.RTM_GETROUTE, false, data, cookie)
+	if err != nil || len(msgs) != 1 {
+		return 0, unix.EINVAL
+	}
+	msg := msgs[0]
+	if len(msg) < unix.SizeofRtMsg || (msg[7] != unix.RTN_UNICAST && msg[7] != unix.RTN_LOCAL) {
+		return 0, unix.EINVAL
+	}
+	attrs, err := kernelPacingAttrs(msg[unix.SizeofRtMsg:])
+	if err != nil || len(attrs[unix.RTA_OIF]) != 4 || attrs[unix.RTA_MULTIPATH] != nil || attrs[30] != nil { // RTA_NH_ID
+		return 0, unix.EINVAL
+	}
+	return int(binary.NativeEndian.Uint32(attrs[unix.RTA_OIF])), nil
+}
+
+func kernelPacingFQ(index int, cookie uint64) bool {
+	request := make([]byte, kernelPacingTcMsgSize)
+	binary.NativeEndian.PutUint32(request[4:], uint32(index))
+	msgs, err := kernelPacingNetlink(unix.RTM_GETQDISC, true, request, cookie)
+	if err != nil {
+		return false
+	}
+	type qdisc struct {
+		handle, parent uint32
+		kind           string
+		paced          bool
+	}
+	var root *qdisc
+	var leaves []qdisc
+	for _, msg := range msgs {
+		if len(msg) < kernelPacingTcMsgSize {
+			return false
+		}
+		if int(binary.NativeEndian.Uint32(msg[4:])) != index {
+			continue
+		}
+		attrs, err := kernelPacingAttrs(msg[kernelPacingTcMsgSize:])
+		if err != nil {
+			return false
+		}
+		kind := attrs[unix.TCA_KIND]
+		if len(kind) == 0 || kind[len(kind)-1] != 0 {
+			return false
+		}
+		q := qdisc{binary.NativeEndian.Uint32(msg[8:]), binary.NativeEndian.Uint32(msg[12:]), string(kind[:len(kind)-1]), false}
+		if q.kind == "fq" {
+			options, err := kernelPacingAttrs(attrs[unix.TCA_OPTIONS])
+			if err != nil {
+				return false
+			}
+			// TCA_FQ_RATE_ENABLE=5, HORIZON=14, OFFLOAD_HORIZON=18.
+			q.paced = len(options[5]) == 4 && binary.NativeEndian.Uint32(options[5]) == 1
+			if v := options[14]; v != nil && (len(v) != 4 || binary.NativeEndian.Uint32(v) < uint32(kernelPacingMaxLead/time.Microsecond)) {
+				q.paced = false
+			}
+			if v := options[18]; v != nil && (len(v) != 4 || binary.NativeEndian.Uint32(v) != 0) {
+				q.paced = false
+			}
+		}
+		if q.parent == 0xffffffff { // TC_H_ROOT
+			if root != nil {
+				return false
+			}
+			root = &q
+		} else if q.parent != 0xfffffff1 { // TC_H_INGRESS / clsact
+			leaves = append(leaves, q)
+		}
+	}
+	if root == nil {
+		return false
+	}
+	if root.kind == "fq" {
+		return root.paced && len(leaves) == 0
+	}
+	if root.kind != "mq" {
+		return false
+	}
+	link := make([]byte, unix.SizeofIfInfomsg)
+	binary.NativeEndian.PutUint32(link[4:], uint32(index))
+	links, err := kernelPacingNetlink(unix.RTM_GETLINK, false, link, cookie)
+	if err != nil || len(links) != 1 || len(links[0]) < unix.SizeofIfInfomsg {
+		return false
+	}
+	attrs, err := kernelPacingAttrs(links[0][unix.SizeofIfInfomsg:])
+	if err != nil || len(attrs[unix.IFLA_NUM_TX_QUEUES]) != 4 {
+		return false
+	}
+	queues := binary.NativeEndian.Uint32(attrs[unix.IFLA_NUM_TX_QUEUES])
+	if queues == 0 || uint32(len(leaves)) != queues {
+		return false
+	}
+	seen := make(map[uint32]bool)
+	for _, leaf := range leaves {
+		minor := leaf.parent & 0xffff
+		if leaf.kind != "fq" || !leaf.paced || leaf.parent&0xffff0000 != root.handle || minor == 0 || minor > queues || seen[minor] {
+			return false
+		}
+		seen[minor] = true
+	}
+	return true
+}
+
+// Bounded, read-only rtnetlink requests. Require the socket and lookup to be in
+// the same network namespace and a complete dump; uncertainty keeps GSO/pacing.
+func kernelPacingNetlink(typ uint16, dump bool, payload []byte, cookie uint64) ([][]byte, error) {
+	fd, err := unix.Socket(unix.AF_NETLINK, unix.SOCK_RAW|unix.SOCK_CLOEXEC, unix.NETLINK_ROUTE)
+	if err != nil {
+		return nil, err
+	}
+	defer unix.Close(fd)
+	ns, err := unix.GetsockoptUint64(fd, unix.SOL_SOCKET, unix.SO_NETNS_COOKIE)
+	if err != nil || ns != cookie {
+		return nil, unix.EINVAL
+	}
+	if err := unix.SetsockoptTimeval(fd, unix.SOL_SOCKET, unix.SO_RCVTIMEO, &unix.Timeval{Usec: 100000}); err != nil {
+		return nil, err
+	}
+	data := make([]byte, unix.NLMSG_HDRLEN, unix.NLMSG_HDRLEN+len(payload))
+	binary.NativeEndian.PutUint32(data, uint32(unix.NLMSG_HDRLEN+len(payload)))
+	binary.NativeEndian.PutUint16(data[4:], typ)
+	flags := uint16(unix.NLM_F_REQUEST)
+	if dump {
+		flags |= unix.NLM_F_DUMP
+	}
+	binary.NativeEndian.PutUint16(data[6:], flags)
+	binary.NativeEndian.PutUint32(data[8:], 1)
+	data = append(data, payload...)
+	if err := unix.Sendto(fd, data, 0, &unix.SockaddrNetlink{Family: unix.AF_NETLINK}); err != nil {
+		return nil, err
+	}
+	buf := make([]byte, 65536)
+	var result [][]byte
+	for received := 0; received < 8<<20; {
+		n, _, flags, from, err := unix.Recvmsg(fd, buf, nil, 0)
+		if err != nil {
+			return nil, err
+		}
+		peer, ok := from.(*unix.SockaddrNetlink)
+		if !ok || peer.Pid != 0 || n == 0 || flags&unix.MSG_TRUNC != 0 {
+			return nil, unix.EINVAL
+		}
+		received += n
+		msgs, err := syscall.ParseNetlinkMessage(buf[:n])
+		if err != nil {
+			return nil, err
+		}
+		for _, msg := range msgs {
+			if msg.Header.Seq != 1 || msg.Header.Flags&unix.NLM_F_DUMP_INTR != 0 {
+				return nil, unix.EINVAL
+			}
+			if msg.Header.Type == unix.NLMSG_ERROR {
+				if len(msg.Data) < 4 {
+					return nil, unix.EINVAL
+				}
+				code := int32(binary.NativeEndian.Uint32(msg.Data))
+				if code != 0 {
+					return nil, syscall.Errno(-code)
+				}
+				continue
+			}
+			if msg.Header.Type == unix.NLMSG_DONE {
+				if len(msg.Data) >= 4 && binary.NativeEndian.Uint32(msg.Data) != 0 {
+					return nil, unix.EINVAL
+				}
+				return result, nil
+			}
+			if msg.Header.Type != typ-2 {
+				return nil, unix.EINVAL
+			}
+			result = append(result, append([]byte(nil), msg.Data...))
+			if !dump {
+				return result, nil
+			}
+		}
+	}
+	return nil, unix.EINVAL
+}
