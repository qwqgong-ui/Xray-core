+func TestKernelPacingTXTimeWriteFallback(t *testing.T) {
+	udp, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4zero})
+	require.NoError(t, err)
+	defer udp.Close()
+	wrapped := &kernelRejectTxTimeConn{UDPConn: udp}
+	raw, err := newConn(wrapped, false, false)
+	require.NoError(t, err)
+	conn := newSendConn(raw, &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1), Port: 34567}, packetInfo{}, utils.DefaultLogger)
+	stamp, err := kernelTxTime(monotime.Now())
+	require.NoError(t, err)
+	require.NoError(t, conn.WriteWithTxTime([]byte{1}, protocol.ECT0, stamp))
+	require.Equal(t, 1, wrapped.timed)
+	require.Equal(t, 1, wrapped.plain)
+	require.True(t, conn.kernelPacingFailed.Load())
