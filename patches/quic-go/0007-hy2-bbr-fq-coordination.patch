+func TestKernelPacingFQPathDetection(t *testing.T) {
+	peer := os.Getenv("QUIC_KERNEL_PACING_PEER")
+	if peer == "" {
+		t.Skip("requires isolated fq route")
+	}
+	udp, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4zero})
+	require.NoError(t, err)
+	defer udp.Close()
+	raw, err := newConn(udp, false, false)
+	require.NoError(t, err)
+	conn := newSendConn(raw, &net.UDPAddr{IP: net.ParseIP(peer), Port: 34567}, packetInfo{}, utils.DefaultLogger)
+	want := os.Getenv("QUIC_KERNEL_PACING_EXPECT_FQ") != "0"
+	require.Equal(t, want, conn.enableKernelPacing())
+	require.Equal(t, want, conn.enableKernelPacing())
+	fd, err := udp.SyscallConn()
+	require.NoError(t, err)
+	var optionErr error
+	require.NoError(t, fd.Control(func(fd uintptr) { optionErr = unix.SetsockoptInt(int(fd), unix.IPPROTO_IP, unix.IP_TOS, 0x28) }))
