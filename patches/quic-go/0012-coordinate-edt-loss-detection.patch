+// 后发控制包的确认不能把正常预约中的数据误判为丢失。
+func TestKernelPacingLossOrdering(t *testing.T) {
+	for _, laterData := range []bool{false, true} {
+		t.Run(map[bool]string{false: "ControlACK", true: "DataACK"}[laterData], func(t *testing.T) {
+			rtt := utils.NewRTTStats()
+			rtt.UpdateRTT(10*time.Millisecond, 0)
+			h := NewSentPacketHandler(0, 1200, rtt, &utils.ConnectionStats{}, false, false, nil, protocol.PerspectiveServer, false, nil, utils.DefaultLogger).(*sentPacketHandler)
+			now := monotime.Now()
+			var tracker packetTracker
+			for pn := protocol.PacketNumber(0); pn <= 4; pn++ {
+				var frames []Frame
+				if pn == 0 || laterData {
+					frames = []Frame{tracker.NewPingFrame(pn)}
+				}
+				h.SentPacket(now, pn, protocol.InvalidPacketNumber, nil, frames, protocol.Encryption1RTT, protocol.ECNNon, 1200, false, false)
+				if pn == 0 || laterData {
+					if marker, ok := any(h).(interface{ MarkKernelPaced(protocol.PacketNumber) }); ok {
+						marker.MarkKernelPaced(pn)
+					}
+				}
+			}
+			_, err := h.ReceivedAck(&wire.AckFrame{AckRanges: ackRanges(4)}, protocol.Encryption1RTT, now.Add(500*time.Microsecond))
+			require.NoError(t, err)
+			if laterData {
+				require.Contains(t, tracker.Lost, protocol.PacketNumber(0))
+				return
+			}
+			require.Empty(t, tracker.Lost)
+			h.detectLostPackets(now.Add(11500*time.Microsecond), protocol.Encryption1RTT)
+			require.Empty(t, tracker.Lost, "时间阈值须包含预约提前量")
+			h.detectLostPackets(now.Add(12500*time.Microsecond), protocol.Encryption1RTT)
+			require.Contains(t, tracker.Lost, protocol.PacketNumber(0), "超过预约和RTT后仍须检出真实丢失")
+		})
+	}
+}
+
+func TestKernelPacingMixedDeadlinesAndReset(t *testing.T) {
+	rtt := utils.NewRTTStats()
+	rtt.UpdateRTT(10*time.Millisecond, 0)
+	h := NewSentPacketHandler(0, 1200, rtt, &utils.ConnectionStats{}, false, false, nil, protocol.PerspectiveServer, false, nil, utils.DefaultLogger).(*sentPacketHandler)
+	now := monotime.Now()
+	var tracker packetTracker
+	h.SentPacket(now, 0, protocol.InvalidPacketNumber, nil, []Frame{tracker.NewPingFrame(0)}, protocol.Encryption1RTT, protocol.ECNNon, 1200, false, false)
+	h.MarkKernelPaced(0)
+	h.SentPacket(now.Add(250*time.Microsecond), 1, protocol.InvalidPacketNumber, nil, []Frame{tracker.NewPingFrame(1)}, protocol.Encryption1RTT, protocol.ECNNon, 1200, false, false)
+	h.SentPacket(now.Add(400*time.Microsecond), 2, protocol.InvalidPacketNumber, nil, nil, protocol.Encryption1RTT, protocol.ECNNon, 40, false, false)
+	h.MarkKernelPaced(2)
+	require.False(t, h.appDataPackets.history.packets[2].kernelPaced, "纯ACK不能标记EDT")
+	_, err := h.ReceivedAck(&wire.AckFrame{AckRanges: ackRanges(2)}, protocol.Encryption1RTT, now.Add(500*time.Microsecond))
+	require.NoError(t, err)
+	require.Equal(t, now.Add(11500*time.Microsecond), h.appDataPackets.lossTime)
+	h.detectLostPackets(now.Add(11600*time.Microsecond), protocol.Encryption1RTT)
+	require.Equal(t, []protocol.PacketNumber{1}, tracker.Lost, "软件包不增加预约余量")
+	h.appDataPackets.largestKernelAcked = 2
+	h.MigratedPath(now.Add(12*time.Millisecond), 1200)
+	require.Equal(t, protocol.InvalidPacketNumber, h.appDataPackets.largestKernelAcked)
+	p := getPacket()
+	p.kernelPaced = true
+	putPacket(p)
+	p = getPacket()
+	require.False(t, p.kernelPaced, "包池不能继承EDT标记")
+	putPacket(p)
+}
