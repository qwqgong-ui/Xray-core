+// MarkKernelPaced 只标记刚登记且将进入同一路 EDT 队列的数据包。
+func (h *sentPacketHandler) MarkKernelPaced(pn protocol.PacketNumber) {
+	space := h.appDataPackets
+	if space.largestSent != pn || len(space.history.packets) == 0 {
+		return
+	}
+	p := space.history.packets[len(space.history.packets)-1]
+	if p != nil && p.IsAckEliciting() && !p.isPathProbePacket && !p.IsPathMTUProbePacket {
+		p.kernelPaced = true
+	}
+}
